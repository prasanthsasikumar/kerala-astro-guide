{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "VITE_EDITION=public npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "/ephe/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/live-token.js": {
      "maxDuration": 15
    },
    "api/log.js": {
      "maxDuration": 15
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/summary.js": {
      "maxDuration": 30
    },
    "api/blindtest.js": {
      "maxDuration": 30
    },
    "api/survey.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/:lang(ml|en|hi|ta|te|kn)",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(ml|en|hi|ta|te|kn)/",
      "destination": "/index.html"
    }
  ]
}
